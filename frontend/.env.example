# Where the API lives. Leave empty when the frontend and API share an origin
# (local development through the Vite proxy, or the API serving the built app).
#
# When the frontend is hosted apart from the API — Vercel serving the app and
# Render running the API — set this to the API's origin, with no trailing slash:
# VITE_API_BASE_URL=https://your-service.onrender.com
#
# Vite inlines VITE_* values at build time, so set this in the hosting
# dashboard and redeploy for it to take effect.
VITE_API_BASE_URL=
