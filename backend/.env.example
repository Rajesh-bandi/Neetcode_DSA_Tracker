# Copy to backend/.env and fill in. .env is gitignored.

PORT=8787
# Where the frontend is served from. Comma-separate several dev origins.
APP_ORIGIN=http://localhost:3000

# Signing key for session cookies. Generated into backend/data/session.secret
# when unset; set it explicitly in production.
# SESSION_SECRET=

# Database file. Defaults to backend/data/tracker.db
# DB_PATH=

# Leave SMTP empty to print verification codes to the server console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google App Password> (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="NeetCode 150 <you@gmail.com>"

NODE_ENV=development
