# Copy to backend/.env and fill in. .env is gitignored.

PORT=8787
# Where the frontend is served from. Comma-separate several origins, e.g. a
# Vercel app plus localhost. Only origins listed here may change data, and they
# are the origins the API answers CORS for.
APP_ORIGIN=http://localhost:3000
# When the frontend runs on a different site than the API, list it here as
# https, e.g. APP_ORIGIN=https://your-app.vercel.app — the session cookie is
# only sent cross-site as SameSite=None, and browsers reject that without
# Secure, so an https app origin is what turns it on.

# Signing key for session cookies. Generated into backend/data/session.secret
# when unset; set it explicitly in production, and keep it stable, or every
# signed-in browser is signed out on deploy.
# SESSION_SECRET=

# Database file. Defaults to backend/data/tracker.db. On hosts with an
# ephemeral filesystem this resets on deploy unless a disk is mounted here.
# DB_PATH=

# Leave SMTP empty to print verification codes to the server console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google App Password> (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="NeetCode 150 <you@gmail.com>"

NODE_ENV=development
